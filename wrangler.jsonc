{
  "name": "flightdeck",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",

  // Non-negotiable (constitution Principle I) — the control-plane surface (SPA + /api/internal/*)
  // must never be reachable on a bare *.workers.dev URL. Module 2's ingest surface
  // (/api/{project_id}/envelope/) IS meant to be public, but on the production custom domain below,
  // not via workers.dev — Principle I is about which routes need Access, not about tolerating the
  // bare workers.dev URL for any route.
  "workers_dev": false,
  // Preview URLs stay enabled for reviewing builds, but MUST be put behind Cloudflare Access
  // manually post-deploy — see README's "Required manual post-deploy step".
  "preview_urls": true,

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, Cloudflare's asset-serving layer intercepts navigation requests (real browser
    // top-level navigations — anything with `Sec-Fetch-Mode: navigate`, which includes the
    // redirect Cloudflare Access sends back to /login after a successful IdP challenge) BEFORE the
    // Worker's own fetch() ever runs, and — because of not_found_handling above — serves the SPA's
    // index.html for them instead. Confirmed live: GET /login returned 200 with the marketing page
    // instead of reaching worker/auth/login-route.ts, so the fd_session cookie was never minted.
    // fetch()/XHR calls (e.g. the SPA's own GET /api/internal/me) don't set that header and were
    // never affected. Scoped to only the paths that need Worker-side logic — marketing routes stay
    // on the cheaper, Worker-skipping asset-serving path.
    "run_worker_first": ["/login", "/logout", "/api/*"]
  },

  // Durable Object class history — script-wide (not per-environment), since it tracks the class's
  // storage migration history for the whole Worker script regardless of which named environment's
  // version is serving traffic. One instance per DSN public key (research.md §4,
  // specs/002-error-monitoring) — sharded by key, never a single global instance.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],

  // Bindings are NOT inheritable across named environments — Wrangler requires each to redeclare
  // them in full, so both environments below are fully explicit and symmetric, mirroring
  // FlareTower's wrangler.jsonc (see that file's comments for the full rationale: no implicit
  // top-level "production" environment, one Worker resource shared by both versions via Workers
  // Builds' native preview mechanism). Local dev (`deno task dev`) picks an environment via the
  // `CLOUDFLARE_ENV` var — see `.env.development` (defaults to `preview`).
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "flightdeck.iuma.dev",
          "custom_domain": true
        }
      ],
      "vars": {
        // Non-secret configuration (identifies which Access application/account, not a
        // credential) — constitution Principle IX reserves Worker secrets for actual credentials.
        "TEAM_DOMAIN": "https://yugai.cloudflareaccess.com",
        "POLICY_AUD": "f79f510d9061fcd9fbf467b45ebc5bf03948636828a1639024ff127a5bcbf97d",
        "CF_ACCOUNT_ID": "8b655d0dde6d223b9ce11116a014973a",
        // The GitHub App's identifier is not a secret (research.md §10, specs/002-error-monitoring)
        // — only its private key is.
        "GITHUB_APP_ID": "4675571"
      },
      "secrets": {
        // Declared here for validation/type-generation only (constitution Principle IX) — the
        // actual value is set via `wrangler versions secret put <NAME>` (no `--env` flag —
        // see FlareTower's wrangler.jsonc for why `--env production` breaks this on a shared
        // Worker script), then promoted with `wrangler versions deploy`. GITHUB_APP_PRIVATE_KEY
        // signs short-lived App JWTs on demand (research.md §10) — never a per-project credential.
        "required": ["SESSION_SECRET", "GITHUB_APP_PRIVATE_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flightdeck-production",
          "database_id": "c14cff3f-5025-46da-8d9a-5425ff6922f8",
          "migrations_dir": "worker/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SOURCE_MAPS",
          "bucket_name": "flightdeck-production-source-maps"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      },
      "triggers": {
        // Daily retention prune (constitution Principle IX — specs/002-error-monitoring
        // research.md §8). Exact hour is not significant; picked to run during low-traffic UTC
        // hours.
        "crons": ["0 3 * * *"]
      }
    },

    // Preview builds (PRs / non-production branches, via Workers Builds' `wrangler deploy
    // --env preview` — a plain, non-versioned deploy, not `versions upload`: this Worker has
    // Durable Objects, which Cloudflare's gradual-deployments/versioned-upload flow doesn't
    // support) get their own D1 database — never the production one.
    "preview": {
      "vars": {
        "TEAM_DOMAIN": "https://yugai.cloudflareaccess.com",
        "POLICY_AUD": "f79f510d9061fcd9fbf467b45ebc5bf03948636828a1639024ff127a5bcbf97d",
        "CF_ACCOUNT_ID": "8b655d0dde6d223b9ce11116a014973a",
        "GITHUB_APP_ID": "4675571"
      },
      "secrets": {
        "required": ["SESSION_SECRET", "GITHUB_APP_PRIVATE_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flightdeck-preview",
          "database_id": "832ca74f-b6d9-4309-a815-311a61a70cb4",
          "migrations_dir": "worker/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SOURCE_MAPS",
          "bucket_name": "flightdeck-preview-source-maps"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      },
      "triggers": {
        "crons": []
      }
    }
  }
}
